# IBKR 模拟网关设置示例：只在 option_data_source: ibkr 时需要。
# 复制到 data/ibkr.env 再改（data/ 不会被提交）。
# IBKR_HOST：运行 IB Gateway 的机器地址；同一台电脑就用 127.0.0.1。
IBKR_HOST=127.0.0.1
# IBKR_PORT：IB Gateway 模拟账户默认 4002。
IBKR_PORT=4002
# IBKR_OPTIONS_CLIENT_ID：API 连接编号，和你别的程序不冲突即可。
IBKR_OPTIONS_CLIENT_ID=27
# IBKR_MARKET_DATA_TYPE：4 = 延迟冻结行情（没订阅实时行情时用）。
IBKR_MARKET_DATA_TYPE=4
